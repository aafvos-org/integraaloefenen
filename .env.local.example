# =====================================================================
# Template voor .env.local — kopieer naar .env.local en vul in.
# Deploy deze keys NOOIT in versioning. .env.local staat in .gitignore.
# =====================================================================

# ---- Supabase ------------------------------------------------------
# Eigen project IntegraalOefenen (niet meer gedeeld met afgeleideoefenen.nl).
# Live staan dezelfde waarden als build-variabelen in Cloudflare Workers Builds.
# Publieke waarden, mogen in de browser terechtkomen:
NEXT_PUBLIC_SUPABASE_URL=https://oyevapifmenqjuklprws.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<jouw supabase anon key>

# Service role — alleen server-side gebruiken, NOOIT exposen:
SUPABASE_SERVICE_ROLE_KEY=<jouw supabase service role key>

# ---- Google Gemini -------------------------------------------------
# Alleen server-side. Vraag een key aan op https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<jouw gemini api key>

# ---- Analyse-route (/api/analyse/sessies) ---------------------------
# Alleen server-side. Is ANALYSE_TOKEN leeg, dan bestaat de route niet (404).
# ANALYSE_SALT bepaalt de pseudoniemen; verander hem niet zonder reden, want
# dan krijgen dezelfde bezoekers een ander pseudoniem.
ANALYSE_TOKEN=<lange willekeurige string>
ANALYSE_SALT=<lange willekeurige string>

# ---- Publieke site-URL (voor metadata, sitemap, robots) ------------
# Laat dit in productie wijzen naar je echte domein, bv:
# NEXT_PUBLIC_SITE_URL=https://integraaloefenen.nl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Mail versturen (Resend) ---------------------------------------
# Alleen server-side. Maak een key aan op https://resend.com/api-keys
# Leeg: er gaat geen enkele mail uit — geen welkomstmail, geen antwoord op
# feedback, geen melding aan de beheerder. Je ziet dat alleen in de logs, de
# leerling merkt er niets van.
RESEND_API_KEY=re_<jouw resend api key>

# Afzender van die mails — dit is een echte waarde, geen invulveld. De naam voor
# de punthaken is wat de leerling in zijn postvak ziet staan.
# Leeg: valt terug op IntegraalOefenen <no-reply@integraaloefenen.nl>.
EMAIL_FROM=IntegraalOefenen <no-reply@integraaloefenen.nl>

# Postvak van de beheerder: hier komt élk bericht aan Aaf binnen — een nieuwe
# aanmelding, een vraag via Aaf, een video-verzoek en feedback. Eén adres, dus
# één plek om het om te zetten (zie src/lib/email/adressen.ts).
# Leeg: er gaat geen bericht aan de beheerder meer uit; dat staat in de logs,
# de leerling krijgt een nette foutmelding.
NOTIFY_EMAIL=<jouw e-mailadres>

# ---- Webhooks vanuit Supabase --------------------------------------
# Alleen server-side. Dezelfde lange willekeurige string staat in de Vault van
# de database (zie scripts/supabase-triggers.sh) en in Cloudflare.
# Leeg of anders: elke webhook wordt met 401 geweigerd, dus geen welkomstmail en
# geen melding bij een nieuwe gebruiker.
WEBHOOK_SECRET=<lange willekeurige string>

# Waar de triggers de webhooks heen sturen. Alleen voor
# scripts/supabase-triggers.sh, die deze waarde in de Vault zet naast het
# geheim hierboven. Leeg: https://www.integraaloefenen.nl.
# WEBHOOK_BASIS_URL=https://www.integraaloefenen.nl

# ---- Supabase die zelf mail stuurt (supabase/config.toml) ----------
# De SMTP-instelling van Supabase leest deze key (bevestigings- en
# herstelmails bij het inloggen). Mag dezelfde key zijn als RESEND_API_KEY.
# Leeg: Supabase verstuurt die twee mails niet, dus een nieuwe leerling krijgt
# geen bevestigingsmail en kan zijn wachtwoord niet herstellen.
RESEND_API_KEY_INTEGRAAL=re_<jouw resend api key>

# ---- Databasewachtwoorden (alleen voor de scripts) -----------------
# Nodig voor scripts/supabase-triggers.sh en
# scripts/verhuis-naar-eigen-supabase.sh. Niet nodig om de site te draaien.
# Leeg: die scripts stoppen meteen met een melding.
SUPABASE_INTEGRAAL_DB_PASSWORD=<databasewachtwoord van IntegraalOefenen>
SUPABASE_PROD_DB_PASSWORD=<databasewachtwoord van het oude gedeelde project>

# E-mailadres voor scripts/reset-user.ts: welke leerling teruggezet moet worden
# naar nieuwe-gebruiker-staat. Mag ook als argument achter het script:
# npx tsx scripts/reset-user.ts <e-mailadres>.
# Leeg: het script stopt meteen met een melding.
RESET_EMAIL=<e-mailadres van de leerling>
