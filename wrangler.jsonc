{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "integraaloefenen",
	"main": "worker.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Elke livegang krijgt een eigen id. De randcache van de startpagina
	// gebruikt dat, zodat een oude pagina niet blijft hangen na een merge.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	// Workers Builds roept `opennextjs-cloudflare deploy` niet aan. Zonder de
	// kopie hierna staan de vooraf gebouwde pagina's niet in de statische
	// bestanden, en geeft een theoriehoofdstuk 404.
	"build": {
		"command": "npm run cf:build"
	},
	"observability": {
		"enabled": true
	}
	// Geheimen (Supabase service role, Resend, Gemini, webhook) staan als
	// Worker-secrets in Cloudflare, nooit in dit bestand.
	// NEXT_PUBLIC_*-waarden worden tijdens de build ingebakken: die staan bij
	// de build-variabelen van Workers Builds.
}
